.profile-intro { padding: 28rpx 0 24rpx; border-bottom: 3rpx solid var(--brand); margin-bottom: 24rpx; }
.profile-title { font-size: 62rpx; font-weight: 800; line-height: 1.18; color: var(--brand); margin-bottom: 12rpx; }
.profile-field { margin-bottom: 20rpx; }
.profile-field label, .field-label { font-weight: 700; }
.profile-field .field { margin-top: 8rpx; }
.roles { margin-top: 25rpx; }
.roles .row { margin-top: 9rpx; gap: 28rpx; }
.roles label { display: flex; align-items: center; min-height: 88rpx; }
.save { width: 100%; margin-top: 16rpx; }
.profile-status { margin-top: 18rpx; padding: 14rpx 0; color: var(--brand); }
.profile-status button { margin-top: 12rpx; }
.shops { margin-top: 35rpx; border-top: 1rpx solid var(--line); padding-top: 24rpx; }
.shop { margin-top: 12rpx; overflow-wrap: anywhere; }
.shop button { flex: none; }
